{
  "name": "avi-infotech-field-service",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "tsx scripts/seed.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed.ts --demo",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:demo": "docker compose run --rm setup npm run seed:demo",
    "docker:backup": "docker compose exec -T mongo mongodump --archive --gzip > backup.gz"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "mongoose": "^8.19.1",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "private": true
}

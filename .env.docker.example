# Docker settings. Copy to .env:  cp .env.docker.example .env
# Then change AUTH_SECRET and SEED_ADMIN_PASSWORD before the first start.

# ── Docker ───────────────────────────────────────────
# Port on this PC where the app opens (http://localhost:3000).
APP_PORT=3000
# MongoDB image version. Use 4.4 on older CPUs without AVX (mongo 5+ will not start there).
MONGO_VERSION=7

# ── Core ─────────────────────────────────────────────
# MongoDB connection string.
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aviinfotech?retryWrites=true&w=majority
# Docker: mongodb://mongo:27017/aviinfotech  (the bundled database, default)
MONGODB_URI="mongodb://mongo:27017/aviinfotech"
# Long random string used to sign login sessions. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of the app. Used in SMS review links and password reset emails.
APP_URL="http://localhost:3000"
APP_NAME="Avi Infotech"

# ── Shop details printed on bills ────────────────────
# Leave STORE_GSTIN empty if you're not GST registered: bills then say "Bill of sale" instead of "Tax invoice".
STORE_ADDRESS="Shop 12, Main Market, Sector 18, Noida, UP 201301"
STORE_PHONE="+91 98100 00000"
STORE_EMAIL=""
STORE_GSTIN=""
# Optional footer text on every bill.
INVOICE_TERMS=""

# ── Live location ────────────────────────────────────
# Days of technician location history kept for the map trail. Older points are deleted automatically.
# (Changing it later: drop the createdAt_1 index on location_pings, then run `npm run setup`.)
LOCATION_HISTORY_DAYS=7

# ── File uploads (completion photos) ─────────────────
# Inside the container; kept in the "uploads" Docker volume.
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_MB=10

# ── SMS ──────────────────────────────────────────────
# "console" logs messages (and shows them under Admin > SMS log). "twilio" sends real SMS.
SMS_PROVIDER="console"
# Prepended to local numbers that don't start with "+", e.g. +91 for India, +1 for US.
SMS_DEFAULT_COUNTRY_CODE="+91"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Set one of these two:
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# ── Email (forgot password) ──────────────────────────
# "console" prints reset links to the server log. "resend" sends real email via resend.com.
EMAIL_PROVIDER="console"
EMAIL_FROM="Avi Infotech <no-reply@example.com>"
RESEND_API_KEY=""

# ── First admin (used by `npm run seed`) ─────────────
SEED_ADMIN_EMAIL="admin@aviinfotech.local"
SEED_ADMIN_PASSWORD="Admin@12345"
